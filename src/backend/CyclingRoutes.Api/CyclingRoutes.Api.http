POST {{CyclingRoutes.Api_HostAddress}}/api/route-intents/validate
Content-Type: application/json
Accept: application/problem+json

{
  "start": { "latitude": 32.0853, "longitude": 34.7818 },
  "shape": "pointToPoint",
  "profile": "gravel",
  "targetDistanceMeters": 0
}

