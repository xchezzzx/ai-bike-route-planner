@CyclingRoutes.Api_HostAddress = https://localhost:7221

### Ranked road loops; up to three ORS calls, requires the server-side key
POST {{CyclingRoutes.Api_HostAddress}}/api/routes/candidates
Content-Type: application/json
Accept: application/json

{
  "start": { "latitude": 32.0853, "longitude": 34.7818 },
  "shape": "loop",
  "profile": "road",
  "targetDistanceMeters": 20000,
  "elevation": "balanced"
}

### Duration-only loop search; explicit initial length assumption of 20 km/h
POST {{CyclingRoutes.Api_HostAddress}}/api/routes/candidates
Content-Type: application/json
Accept: application/json

{
  "start": { "latitude": 32.0853, "longitude": 34.7818 },
  "shape": "loop",
  "profile": "road",
  "targetDurationSeconds": 3600,
  "elevation": "minimize"
}

### Real point-to-point road route; requires the server-side ORS key
POST {{CyclingRoutes.Api_HostAddress}}/api/routes/generate
Content-Type: application/json
Accept: application/json

{
  "start": { "latitude": 32.0853, "longitude": 34.7818 },
  "destination": { "latitude": 32.1, "longitude": 34.82 },
  "shape": "pointToPoint",
  "profile": "road",
  "targetDistanceMeters": 5000
}

###

GET {{CyclingRoutes.Api_HostAddress}}/health
Accept: text/plain

###

POST {{CyclingRoutes.Api_HostAddress}}/api/route-intents/validate
Content-Type: application/json
Accept: application/json

{
  "start": { "latitude": 32.0853, "longitude": 34.7818 },
  "shape": "loop",
  "profile": "road",
  "targetDistanceMeters": 40000,
  "targetDurationSeconds": 7200
}

###

POST {{CyclingRoutes.Api_HostAddress}}/api/route-intents/validate
Content-Type: application/json
Accept: application/problem+json

{
  "start": { "latitude": 32.0853, "longitude": 34.7818 },
  "shape": "pointToPoint",
  "profile": "gravel",
  "targetDistanceMeters": 0
}

